{
  "manifest_version": 3,
  "name": "Brainy Visual Controller",
  "version": "0.1.0",
  "description": "Designer-driven visual editor for cxui apps. Click an element, edit through Figma-style controls, copy a change prompt for Claude Code.",
  "permissions": ["scripting", "activeTab", "clipboardWrite", "storage"],
  "host_permissions": [
    "http://localhost/*",
    "https://localhost/*",
    "https://*.coralogix.com/*",
    "https://*.app.coralogix.com/*"
  ],
  "background": { "service_worker": "dist/background/service-worker.js" },
  "content_scripts": [],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CX-Visual — click to activate",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["dist/page-world/signal-bridge.js", "data/*.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
